{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/02-consumer-agent-skill/output.schema.json",
  "title": "D-to-A Unified Agent Output",
  "type": "object",
  "required": ["agent_name", "score", "pass", "problem_list", "modify_suggestion", "protected_content", "meta"],
  "properties": {
    "agent_name": {"const": "consumer_agent"},
    "score": {"type": "integer", "minimum": 0, "maximum": 10},
    "pass": {"type": "boolean"},
    "problem_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3},
    "modify_suggestion": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3},
    "protected_content": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "meta": {
      "type": "object",
      "required": ["judge_dimensions", "confidence"],
      "properties": {
        "judge_dimensions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
