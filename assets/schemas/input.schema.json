{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/02-consumer-agent-skill/input.schema.json",
  "title": "A-to-D Unified Agent Input",
  "type": "object",
  "required": ["poster_image", "product_input"],
  "properties": {
    "poster_image": {"type": "string", "minLength": 1},
    "product_input": {
      "type": "object",
      "required": ["product_img", "selling_points", "price_text", "marketing_target", "scene_tags"],
      "properties": {
        "product_img": {"type": "string", "minLength": 1},
        "selling_points": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "price_text": {"type": "string"},
        "marketing_target": {"type": "string", "minLength": 1},
        "scene_tags": {
          "type": "array",
          "prefixItems": [
            {"type": "string", "minLength": 1},
            {"type": "string", "minLength": 1},
            {"type": "string", "minLength": 1}
          ],
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
